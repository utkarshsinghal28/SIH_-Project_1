# ---------------------------------------------------------------------------
# Krishi Procurement Platform - client environment
# Copy this file to `client/.env` and adjust if needed.
#
# PART 1 (now): no backend exists, so the mock layer is used by default.
#               You do NOT need to set anything to run Part 1.
# PART 2 (next): start the Express API, then set VITE_USE_MOCK_API=false.
# ---------------------------------------------------------------------------

# Base URL of the Express REST API that Part 2 will provide.
VITE_API_BASE_URL=http://localhost:5000/api

# "true"  -> use the in-browser mock layer in src/data/mock (Part 1 default)
# "false" -> send every request to VITE_API_BASE_URL with Axios (Part 2 onwards)
VITE_USE_MOCK_API=true
