# ---------------------------------------------------------------------------
# Krishi Procurement Platform - client environment
# Copy this file to `client/.env` if you need to change the defaults.
# ---------------------------------------------------------------------------

# Base URL of the Express REST API (Part 2 backend).
# For local development the Vite dev server proxies /api to the backend, so the
# default relative URL works without any configuration.
VITE_API_BASE_URL=/api

# Offline fallback for frontend-only work when no backend is running.
# "false" (default) -> talk to the real Express + MongoDB API
# "true"            -> use the in-browser Part 1 mock layer in src/data/mock
VITE_USE_MOCK_API=false
