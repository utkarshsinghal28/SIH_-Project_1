    "cors": "^2.8.5",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server-core": "^10.1.4",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "next": "16.2.6",
    "nodemon": "^3.1.9",
    "pg": "8.20.0",
