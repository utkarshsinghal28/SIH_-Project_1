# ---------------------------------------------------------------------------
# Krishi Procurement Platform - backend environment (Part 2)
# Copy to `server/.env` and fill in real values. NEVER commit server/.env.
# ---------------------------------------------------------------------------

# Port the Express API listens on
PORT=5000

# development | production
NODE_ENV=development

# MongoDB Atlas connection string.
# Atlas -> Cluster -> Connect -> Drivers -> copy the SRV string and add the
# database name before the query string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/krishi_procurement?retryWrites=true&w=majority

# Secret used to sign JWTs. Use a long random string, at least 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# How long an issued token stays valid (zeit/ms format: 7d, 12h, 30m)
JWT_EXPIRES_IN=7d

# Origin of the Vite dev server, used for the CORS allow-list
CLIENT_URL=http://localhost:5173

# Local development escape hatch: start a temporary in-memory MongoDB instead of
# connecting to Atlas. All data is lost on shutdown. Must stay false in production.
USE_IN_MEMORY_DB=false
